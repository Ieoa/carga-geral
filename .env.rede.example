DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-grande-e-unica
DEBUG=False
DESKTOP_MODE=False
# Somente para homologacao na rede interna. Em producao, sirva uploads por infraestrutura dedicada.
SERVE_MEDIA_LOCALLY=True

# O host deve ser o servidor MySQL da empresa, nunca 127.0.0.1 neste modo.
DATABASE_URL=mysql://historico_navios:troque-a-senha@mysql-servidor.empresa.local:3306/historico_navios

# Inclua o IP e/ou nome DNS do computador que executara o LOGGERAL.
ALLOWED_HOSTS=127.0.0.1,localhost,loggeral-servidor,192.168.1.50
PUBLIC_BASE_URL=http://192.168.1.50:8000
CSRF_TRUSTED_ORIGINS=

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Carga Geral <nao-responda@empresa.com.br>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Active Directory opcional. Ative somente depois da homologacao com login local.
AD_AUTH_ENABLED=False
AD_SERVER_URI=ldaps://ad.empresa.local:636
AD_BIND_DN=CN=svc_loggeral,OU=Contas de Servico,DC=empresa,DC=local
AD_BIND_PASSWORD=
AD_USER_SEARCH_BASE=DC=empresa,DC=local
AD_USER_FILTER=(sAMAccountName={username})
AD_START_TLS=False
AD_CREATE_USERS=True
AD_ALWAYS_UPDATE_USER=True
