DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-grande-e-unica
DEBUG=False
DESKTOP_MODE=False
# Mantem fotos, videos e PDFs sob autenticacao e controle de permissao do Django.
SERVE_MEDIA_LOCALLY=True

# O host deve ser o servidor MySQL da empresa, nunca 127.0.0.1 neste modo.
DATABASE_URL=mysql://historico_navios:troque-a-senha@mysql-servidor.empresa.local:3306/historico_navios
MYSQL_CONNECT_TIMEOUT=10
MYSQL_READ_TIMEOUT=30
MYSQL_WRITE_TIMEOUT=30
# Informe o certificado da CA corporativa quando o MySQL oferecer TLS.
MYSQL_SSL_CA=

# Inclua o IP e/ou nome DNS do computador que executara o LOGGERAL.
ALLOWED_HOSTS=127.0.0.1,localhost,loggeral-servidor,192.168.1.50
PUBLIC_BASE_URL=http://192.168.1.50:8000
CSRF_TRUSTED_ORIGINS=

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=Carga Geral <nao-responda@empresa.com.br>
EMAIL_HOST=smtp.empresa.local
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Active Directory da GLIBRA. A matricula deve ser autorizada antes no LOGGERAL.
AD_AUTH_ENABLED=False
AD_SERVER_URI=ldap://glibra.corp:389
AD_DIRECT_BIND=True
AD_DOMAIN=glibra
AD_START_TLS=True
AD_TLS_VALIDATE=True
AD_CA_CERT_FILE=C:\certificados\ca-corporativa.pem
AD_CONNECT_TIMEOUT=5
AD_RECEIVE_TIMEOUT=10

# Não são usados no bind direto. Preencha somente se a TI optar por conta de serviço.
AD_BIND_DN=
AD_BIND_PASSWORD=
AD_USER_SEARCH_BASE=dc=glibra,dc=corp
AD_USER_FILTER=(sAMAccountName={username})

# LOGGERAL Insight: executado somente no servidor da aplicação.
INSIGHT_ML_ENABLED=True
INSIGHT_STATISTICAL_MIN_SAMPLES=30
INSIGHT_ML_MIN_SAMPLES=100
INSIGHT_CONTAMINATION=0.10
LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW_SECONDS=900
