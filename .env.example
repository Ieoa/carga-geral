EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Active Directory (opcional). Prefira LDAPS em producao.
AD_AUTH_ENABLED=False
