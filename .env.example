DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-grande-e-unica
DEBUG=True
DESKTOP_MODE=False
SERVE_MEDIA_LOCALLY=False
DATABASE_URL=mysql://historico_navios:troque-a-senha@127.0.0.1:3306/historico_navios
MYSQL_CONNECT_TIMEOUT=10
MYSQL_READ_TIMEOUT=30
MYSQL_WRITE_TIMEOUT=30
MYSQL_SSL_CA=
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
PUBLIC_BASE_URL=
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Carga Geral <nao-responda@empresa.com.br>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Active Directory opcional. A conta precisa estar autorizada previamente no LOGGERAL.
AD_AUTH_ENABLED=False
AD_SERVER_URI=ldap://ad.empresa.local:389
AD_DIRECT_BIND=True
AD_DOMAIN=empresa
AD_START_TLS=True
AD_TLS_VALIDATE=True
AD_CA_CERT_FILE=
AD_CONNECT_TIMEOUT=5
AD_RECEIVE_TIMEOUT=10

# Somente para o modo alternativo com conta de servico (AD_DIRECT_BIND=False).
AD_BIND_DN=
AD_BIND_PASSWORD=
AD_USER_SEARCH_BASE=
AD_USER_FILTER=(sAMAccountName={username})

# LOGGERAL Insight: análise inteiramente local, sem API externa.
INSIGHT_ML_ENABLED=True
INSIGHT_STATISTICAL_MIN_SAMPLES=30
INSIGHT_ML_MIN_SAMPLES=100
INSIGHT_CONTAMINATION=0.10
LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW_SECONDS=900
